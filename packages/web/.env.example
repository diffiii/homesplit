# Backend origin that /api/* is rewritten to. Required at build time and by `next dev`,
# unless NEXT_PUBLIC_API_MOCKS is on.
# Server-only: never prefix it with NEXT_PUBLIC_.
API_URL=http://localhost:8080

# Answer /api/* in the browser from in-memory mocks instead of a backend (`next dev` only).
# Switch scenarios, users, and network conditions on /dev/mocks.
# NEXT_PUBLIC_API_MOCKS=true

# Origin the app is served from, for canonical URLs and link preview images.
# Defaults to production; set it for staging or another domain.
# SITE_URL=http://localhost:3000

# Largest attachment the upload accepts, checked before sending. Match the backend's
# ATTACHMENT_MAX_BYTES when it isn't the default of 10485760 (10 MiB).
# NEXT_PUBLIC_ATTACHMENT_MAX_BYTES=10485760

# Largest avatar the upload accepts, checked before sending. Match the backend's
# AVATAR_MAX_BYTES when it isn't the default of 10485760 (10 MiB).
# NEXT_PUBLIC_AVATAR_MAX_BYTES=10485760
