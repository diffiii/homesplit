{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('public/mockServiceWorker.js', { force: true })\" && next build",
    "dev": "msw init public --no-save && next dev",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
