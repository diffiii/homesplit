{
  "name": "backend",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "attachments:clean-up": "node --env-file-if-exists=.env dist/scripts/clean-up-attachments.js",
    "attachments:thumbnails": "node --env-file-if-exists=.env dist/scripts/generate-attachment-thumbnails.js",
    "auth:generate": "auth generate --config src/auth.ts --output src/db/schema/auth.ts --yes",
    "build": "nest build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "dev": "nest start --watch --exec \"node --env-file-if-exists=.env\"",
    "start": "nest start --exec \"node --env-file-if-exists=.env\"",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0",
    "@better-auth/drizzle-adapter": "^1.7.27",
    "@homesplit/contracts": "workspace:*",
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/throttler": "^6.8.0",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "better-auth": "^1.7.27",
    "drizzle-orm": "^0.45.4",
    "file-type": "^22.3.0",
    "heic-decode": "^2.1.0",
    "openai": "^7.62.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.39.0",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@nestjs/schematics": "^12.0.16",
    "@swc/core": "^1.16.22",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "auth": "^1.7.27",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.2",
    "typescript": "^6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
