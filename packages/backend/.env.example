PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/homesplit

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8080

FRONTEND_URL=http://localhost:3000
RESEND_API_KEY=
MAIL_FROM=HomeSplit <onboarding@resend.dev>

# Public origin of the web app. Browsers reach the API only through its `/api/*`
# rewrite, so Better Auth uses it as its base URL, and emails link to its pages.
# Session cookies are `Secure` when it's https.
FRONTEND_URL=http://localhost:3000

# Comma-separated extra origins allowed to call the API, such as Vercel preview
# deployments of the web app. `*` matches any characters, for example
# https://homesplit-web-*-<team>.vercel.app
FRONTEND_PREVIEW_ORIGINS=
