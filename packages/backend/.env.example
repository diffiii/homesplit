PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/homesplit

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8080

RESEND_API_KEY=
MAIL_FROM=HomeSplit <onboarding@resend.dev>

# Public origin of the web app. Browsers reach the API only through its `/api/*`
# rewrite, so Better Auth uses it as its base URL, and emails link to its pages.
# Session cookies are `Secure` when it's https.
FRONTEND_URL=http://localhost:3000

# Comma-separated extra origins allowed to call the API, such as Vercel preview
# deployments of the web app. `*` matches any characters, for example
# https://homesplit-web-*-<team>.vercel.app
FRONTEND_PREVIEW_ORIGINS=

# S3-compatible object storage for attachments: AWS S3, Cloudflare R2, MinIO, …
# These values match the `object-storage` service (SeaweedFS) in compose.yaml.
# For AWS, leave S3_ENDPOINT empty and S3_FORCE_PATH_STYLE false; for R2, set
# S3_REGION=auto.
# `STORAGE_DRIVER=memory` keeps files in process memory, for tests only.
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=homesplit-attachments
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=homesplit
S3_SECRET_ACCESS_KEY=homesplit-dev-secret

# Upload size limit in bytes, lifetime of signed download URLs, age after
# which unreferenced attachments are cleaned up, and most files linked to one
# expense (docs/api/attachments.md).
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_DOWNLOAD_URL_TTL_SECONDS=300
ATTACHMENT_UNREFERENCED_TTL_HOURS=24
ATTACHMENT_MAX_PER_EXPENSE=10
