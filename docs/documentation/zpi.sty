% Sequence diagrams
\tikzset{
  sd participant/.style={draw, fill=white, align=center, font=\small, minimum height=0.9cm, text width=2.3cm, inner sep=2pt},
  sd lifeline/.style={densely dashed, gray},
  sd call/.style={-{Triangle[length=2mm, width=1.6mm]}},
  sd reply/.style={densely dashed, -{Straight Barb[length=2mm]}},
  sd text/.style={font=\footnotesize, inner sep=1.5pt, fill=white},
  sd guard/.style={font=\footnotesize\itshape, inner sep=2pt, anchor=north west},
}
% \sdparticipant{x}{name}{lifeline end y}
\newcommand\sdparticipant[3]{%
  \node[sd participant] at (#1,0) {#2};
  \draw[sd lifeline] (#1,-0.45) -- (#1,#3);}
% \sdcall{from x}{to x}{y}{label}, \sdreply{from x}{to x}{y}{label}
\newcommand\sdcall[4]{\draw[sd call] (#1,#3) -- node[sd text, above] {#4} (#2,#3);}
\newcommand\sdreply[4]{\draw[sd reply] (#1,#3) -- node[sd text, above] {#4} (#2,#3);}
% \sdself{x}{y}{label}
\newcommand\sdself[3]{%
  \draw[sd call] (#1,#2) -- ++(0.45,0) -- ++(0,-0.3) -- ++(-0.45,0);
  \node[sd text, anchor=south west] at (#1,#2) {#3};}
% \sdframe{left x}{top y}{right x}{bottom y}{operator}{guard}
\newcommand\sdframe[6]{%
  \draw (#1,#2) rectangle (#3,#4);
  \node[draw, fill=white, font=\footnotesize\bfseries, inner sep=2pt, anchor=north west] (sdtag) at (#1,#2) {#5};
  \node[sd guard] at (sdtag.north east) {#6};}
% \sdelse{left x}{right x}{y}{guard}
\newcommand\sdelse[4]{%
  \draw[densely dashed] (#1,#3) -- (#2,#3);
  \node[sd guard] at (#1,#3) {#4};}

% Activity diagrams
\tikzset{
  ad action/.style={draw, rounded corners=7pt, align=center, font=\small, execute at begin node={\hyphenpenalty=10000}, text width=2.6cm, minimum height=0.9cm, inner sep=3pt, fill=white},
  ad decision/.style={draw, diamond, aspect=1.6, minimum width=0.9cm, minimum height=0.6cm, inner sep=0pt, fill=white},
  ad start/.style={circle, fill=black, minimum size=3mm, inner sep=0pt},
  ad end/.style={circle, draw, double, double distance=1.2pt, fill=black, minimum size=2.6mm, inner sep=0pt},
  ad flow end/.style={circle, draw, minimum size=3mm, inner sep=0pt, path picture={\draw (path picture bounding box.north west) -- (path picture bounding box.south east) (path picture bounding box.north east) -- (path picture bounding box.south west);}},
  ad flow/.style={-{Stealth[length=2.2mm]}},
  ad guard/.style={font=\footnotesize, inner sep=2pt},
}
