<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_shopping-to-be" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_main" name="Wspólne zakupy z HomeSplit" processRef="Process_shopping-to-be" />
  </bpmn:collaboration>
  <bpmn:process id="Process_shopping-to-be" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_K" name="Kupujący">
        <bpmn:flowNodeRef>Shop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Receipt</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_S" name="System HomeSplit">
        <bpmn:flowNodeRef>Balances</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P" name="Pozostali domownicy">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AddItems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Settle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Brakuje produktów">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="AddItems" name="Dodaj produkty do wspólnej listy">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="Shop" name="Zrób zakupy według listy">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:subProcess id="Receipt" name="Dodaj wydatek z paragonu">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:serviceTask id="Balances" name="Przelicz salda i sugestie">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:subProcess id="Settle" name="Rozlicz spłatę">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:subProcess>
    <bpmn:endEvent id="End" name="Koszty rozliczone">
      <bpmn:incoming>Flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="AddItems" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="AddItems" targetRef="Shop" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Shop" targetRef="Receipt" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Receipt" targetRef="Balances" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Balances" targetRef="Settle" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Settle" targetRef="End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_main_di" bpmnElement="Participant_main" isHorizontal="true"><dc:Bounds x="0" y="0" width="930" height="360" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_K_di" bpmnElement="Lane_K" isHorizontal="true"><dc:Bounds x="30" y="0" width="900" height="120" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_S_di" bpmnElement="Lane_S" isHorizontal="true"><dc:Bounds x="30" y="120" width="900" height="120" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_P_di" bpmnElement="Lane_P" isHorizontal="true"><dc:Bounds x="30" y="240" width="900" height="120" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="97" y="282" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="65" y="322" width="100" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AddItems_di" bpmnElement="AddItems"><dc:Bounds x="172" y="260" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shop_di" bpmnElement="Shop"><dc:Bounds x="306" y="20" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Receipt_di" bpmnElement="Receipt" isExpanded="false"><dc:Bounds x="440" y="20" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Balances_di" bpmnElement="Balances"><dc:Bounds x="574" y="140" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Settle_di" bpmnElement="Settle" isExpanded="false"><dc:Bounds x="708" y="260" width="110" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End"><dc:Bounds x="857" y="282" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="825" y="322" width="100" height="28" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="133" y="300" /><di:waypoint x="172" y="300" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="282" y="300" /><di:waypoint x="361" y="300" /><di:waypoint x="361" y="100" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="416" y="60" /><di:waypoint x="440" y="60" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="550" y="60" /><di:waypoint x="629" y="60" /><di:waypoint x="629" y="140" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="684" y="180" /><di:waypoint x="763" y="180" /><di:waypoint x="763" y="260" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="818" y="300" /><di:waypoint x="857" y="300" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
