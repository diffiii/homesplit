      <bpmndi:BPMNEdge id="Message_2_di" bpmnElement="Message_2"><di:waypoint x="375" y="390" /><di:waypoint x="375" y="320" /><bpmndi:BPMNLabel><dc:Bounds x="380" y="348" width="97" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Message_3_di" bpmnElement="Message_3"><di:waypoint x="1117" y="320" /><di:waypoint x="1117" y="390" /><bpmndi:BPMNLabel><dc:Bounds x="1057" y="348" width="55" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Message_4_di" bpmnElement="Message_4"><di:waypoint x="1145" y="390" /><di:waypoint x="1145" y="320" /><bpmndi:BPMNLabel><dc:Bounds x="1150" y="348" width="83" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
