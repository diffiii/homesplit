{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next"
  ],
  "assist": {
    "actions": {
      "source": {
        "useSortedKeys": "off",
        "useSortedProperties": "off"
      }
    }
  },
  "javascript": {
    "parser": {
      // NestJS uses parameter decorators (@Param, @Body, @Query).
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "overrides": [
    {
      // The React preset reads any `use*` call as a hook, such as Nest's `app.useGlobalFilters`.
      "includes": ["packages/backend/**", "packages/contracts/**"],
      "linter": {
        "rules": {
          "correctness": {
            "useHookAtTopLevel": "off"
          },
          // Nest controllers and services are injectable classes whose methods
          // often don't read `this`, as they query the module-level `db`.
          "style": {
            "useThisInClassMethods": "off"
          }
        }
      }
    },
    {
      // Generated by the shadcn CLI and updated by rerunning it, so it isn't linted, only formatted.
      "includes": [
        "packages/web/src/components/ui/**",
        "packages/web/src/hooks/use-mobile.ts"
      ],
      "linter": {
        "enabled": false
      }
    },
    {
      // Inline handlers are the idiom for TanStack Form fields and Base UI parts;
      // memoizing each one adds noise without measurable gain at this size.
      "includes": ["packages/web/**"],
      "linter": {
        "rules": {
          "performance": {
            "noJsxPropsBind": "off"
          }
        }
      }
    }
  ],
  "linter": {
    // Generated by the shadcn CLI and updated by rerunning it, so it's formatted but not linted.
    "includes": [
      "**",
      "!packages/web/src/components/ui/**",
      "!packages/web/src/hooks/use-mobile.ts"
    ]
  },
  "files": {
    "includes": ["!**/src/db/migrations"]
  }
}
