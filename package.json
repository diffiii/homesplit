{
  "name": "homesplit",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "build:backend": "pnpm --filter backend... build",
    "build:web": "pnpm --filter web... build",
    "db:down": "docker compose down",
    "db:test:down": "docker compose --profile test rm --stop --force postgres-test",
    "db:test:up": "docker compose --profile test up -d --wait postgres-test",
    "db:up": "docker compose up -d --wait",
    "dev": "pnpm -r --parallel dev",
    "dev:backend": "pnpm --filter backend dev",
    "dev:web": "pnpm --filter web... --parallel dev",
    "e2e:web": "pnpm --filter \"web^...\" build && pnpm --filter web e2e",
    "e2e:web:backend": "pnpm --filter \"web^...\" --filter \"backend^...\" build && pnpm --filter web e2e:backend",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "prepare": "husky",
    "test:backend": "pnpm --filter \"backend^...\" build && pnpm --filter backend test",
    "test:contracts": "pnpm --filter @homesplit/contracts test",
    "test:web": "pnpm --filter \"web^...\" build && pnpm --filter web test",
    "typecheck": "pnpm -r typecheck"
  },
  "lint-staged": {
    "*": "pnpm lint"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@commitlint/cli": "latest",
    "@commitlint/config-conventional": "latest",
    "husky": "latest",
    "lint-staged": "latest",
    "ultracite": "latest"
  },
  "packageManager": "pnpm@12.21.0"
}
